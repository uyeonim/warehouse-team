# 복사해서 keycap_flask/.env 로 저장. .env 는 절대 커밋·공유 금지
# ---- Mobius (플랫폼 서버) ----
COSS_BASE_URL=http://192.168.0.100:7579/Mobius
AE_NAME=
ORIGIN=
# 로컬 Mobius는 인증 헤더 불필요 - 비워둠
COSS_API_KEY=
COSS_LECTURE=
COSS_CREATOR=

# ---- 창고 PC Redis (보드 Flask와 같은 Redis, 키 이름이 달라 안 섞임) ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- MQTT: 받은 주문을 키캡 아두이노에 전달 (플랫폼 서버 Mosquitto, TLS 없음, 익명) ----
MQTT_HOST=192.168.0.100
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# ---- Mobius 구독 알림 주소 (make_sub.py) ----
NOTIFY_BASE_URL=http://192.168.0.12:5002
