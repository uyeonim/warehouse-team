# 복사하여 .env.local로 저장. 기존 .env/클라우드 설정은 덮어쓰지 않음.
# 2026-11-02 구조 문서 기준. 아래 AE/Origin과 COM 번호는 현장 확인 필요.
WAREHOUSE_PROFILE=local
MOBIUS_URL=http://192.168.0.100:7579
MOBIUS_CB=Mobius
MOBIUS_AE_RN=
MOBIUS_AEI=
BOARD_API_URL=http://127.0.0.1:5000
PROCESS_PATH=cnt_process
PROCESS_POLL_SEC=5
# Mobius cnt_process 알림을 직접 받음 (MQTT 안 씀). 구독은 make_sub.py로 등록
NOTIFY_PORT=5003
NOTIFY_BASE_URL=http://192.168.0.12:5003
REPORT_ROOT=
HARDWARE=dobot
REACT_ASSIGNED=1
SET1_PORT=COM6
SET2_PORT=COM7
TRAY_PORT=COM8
# USB 시리얼(장치관리자 > 포트 > 속성 > 부모 USB\VID_F055&PID_9800\<시리얼>, 또는 check_all.bat)
# 적어 두면 COM 번호 대신 시리얼로 팔을 찾음 - USB를 다시 꽂아 번호가 바뀌어도 팔이 안 뒤바뀜. 비우면 *_PORT 사용
SET1_SERIAL=
SET2_SERIAL=
TRAY_SERIAL=
ARMS_TAKE_TURNS=1
# 좌표: design = 도면 배치 (트레이 팔은 pose_tray_design.json — 지우면 트레이 팔 좌표 없음!). 찍은 pose_*.json 이 최우선
LAYOUT=design
# 놓은 뒤 들기·당기기 생략 — 2026-11-02 시험 OK (참고사항 10장)
PLACE_LIFT=0
# 트레이 실패 fault 가 풀린 뒤 트레이를 다시 올리고, 놓았으면 개수를 뺌 (1, 기본). 0 = 예전 동작.
TRAY_FAULT_FIX=1
FAKE_UNBUILT=0
FAKE_TRAY_CONVEYOR=0
FAKE_TRAY_SECTION0=0
FAKE_TRAY_SECTION2=0
FAKE_BOARD_ARM=0
FAKE_BOARD_DISPENSE=0
CHECK_GRIP_IR=0
CHECK_BOARD_COLOR=0
# fault 해제 = 사람이 조치 완료 → 키캡 팔 결과를 done 으로 다시 보고 (10/8 검증한 복구 흐름)
MANUAL_FIX_DONE=1
DRY_RUN=0
FORCE_FAIL=
