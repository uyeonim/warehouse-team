# 복사해서 board/.env 로 저장 (보드 main + 보드 Flask 공용). .env 는 절대 커밋·공유 금지
# ---- Mobius (플랫폼 서버) ----
COSS_BASE_URL=http://192.168.0.100:7579/Mobius
AE_NAME=
ORIGIN=
# 로컬 Mobius는 인증 헤더 불필요 - 비워둠
COSS_API_KEY=
COSS_LECTURE=
COSS_CREATOR=

# ---- 창고 PC Redis (보드 Flask가 사용) ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- 보드 main -> 보드 Flask ----
FLASK_BASE_URL=http://127.0.0.1:5000

# ---- 보드 main의 Mobius 알림 수신 (구독은 tools/sub_robotarm.py) ----
NOTIFY_PORT=5001
NOTIFY_BASE_URL=http://192.168.0.12:5001
